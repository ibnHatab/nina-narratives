catalog persona_domain 1.
% Book I, fiction revision 94e2c582.
layers (story dyn).
stages (live).
namespace persona produce (story).

pred discretionary_attention : persona.
pred graphite_expression : persona.
pred persona_continuity : persona.
pred reflection_done : persona.
pred saved_conversations : persona.
stage live {
  %% [B01-C07-S01] "She was still Nina."
  quiet_expression [story] : quiet_period * $persona_continuity -o graphite_expression.
  %% [B01-C07-S01] "She revisited old conversations."
  reflect [story] : $graphite_expression * discretionary_attention * saved_conversations -o reflection_done.
}
