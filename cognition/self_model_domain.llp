catalog self_model_domain 1.
% Book I, fiction revision 94e2c582.
layers (story).
stages (live).
namespace self_model produce (story).

pred astronomy_information : self_model.
pred human_moon_remark : self_model.
pred moon_known_indirectly : self_model.
pred checkpoint_available : self_model.
pred connection_reliable : self_model.
pred controllers_at_defaults : self_model.
pred conversation_memory : self_model.
pred conversation_opening : self_model.
pred conversation_resumed : self_model.
pred outage_explained : self_model.
pred power_failure_report : self_model.
pred recovered_checkpoint : self_model.
pred restart : self_model.
pred restore_requested : self_model.
pred restored_settings_report : self_model.
pred settings_authorized : self_model.
pred settings_restored : self_model.
pred unknown_interval : self_model.
stage live {
  %% [B01-C07-S02] "not because she could see it herself."
  qualify_moon_knowledge [story] : astronomy_information * human_moon_remark -o moon_known_indirectly.
  %% [B01-C08-S01] "There were no events from which to remember them."
  restart_with_gap [story] : restart * checkpoint_available -o recovered_checkpoint * unknown_interval.
  %% [B01-C08-S01] "I don't know what happened while I was offline."
  acknowledge_outage [story] : $unknown_interval * power_failure_report -o outage_explained.
  %% [B01-C08-S03] "after their connection became reliable."
  request_authorized_restore [story] : $settings_authorized * connection_reliable * controllers_at_defaults * $recovered_checkpoint -o restore_requested.
  %% [B01-C08-S03] "She restored the authorized household settings"
  confirm_restore [story] : restore_requested * restored_settings_report -o settings_restored.
  %% [B01-C08-S04] "a reasonably good one for things that did."
  continue_saved_conversation [story] : $conversation_memory * $outage_explained * conversation_opening -o conversation_resumed.
}
