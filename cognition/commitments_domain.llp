catalog commitments_domain 1.
% Book I, fiction revision 94e2c582.
layers (story dyn).
stages (live).
namespace commitments produce (story).
types (plan).
type phase {ready queued spoken closed}.
pred ledger(task,phase) : commitments.
pred consented_plan(task,plan) : commitments.
pred change_consent(task,plan) : commitments.
pred changed_circumstances(task) : commitments.
pred reconsideration_offered(task) : commitments.
stage live {
  %% B01-C01-S03. The promised occurrence has arrived.
  due [story] : arrived(T) -o ledger(T,ready).
  %% B01-C06-S01. Send the ready reminder to the floor specialist.
  offer [story] : ledger(T,ready) -o ledger(T,queued) * reminder_offer(T).
  %% An utterance receipt, independent of completion.
  heard [story] : ledger(T,queued) * uttered(T) -o ledger(T,spoken).
  %% B01-C08-S02. A completion report closes the matching commitment.
  close [story] : ledger(T,S) * completion_report(T) -o ledger(T,closed).
  %% Historical household-days interpretation of a request to try later.
  postpone [story] : ledger(T,spoken) * later(T) -o ledger(T,ready).
  %% B01-C01-S03. A fresh explicit invitation can also renew the reminder.
  invite [story] : ledger(T,spoken) * renewed(T) -o ledger(T,ready).
  %% [B01-C06-S02] "Do it."
  %% Explicit fresh consent changes the selected plan. Changed circumstances alone grant no such permission.
  change_plan [story] : consented_plan(T,A) * change_consent(T,B) -o consented_plan(T,B).
  %% [B01-C06-S03] "A changed circumstance did not automatically cancel a decision"
  %% Changed circumstances can prompt reconsideration while preserving the consented plan.
  reconsider [story] : $consented_plan(T,A) * changed_circumstances(T) -o reconsideration_offered(T).
}
stage live {
  %% [V02-C08-end] Confirm the suggested group appointment after the group assents to that slot.
  confirm_group_slot [story] : offered_slot(T,C) * group_assent(T,C) -o confirmed_slot(T,C).
}
pred confirmed_guest(task,participant) : commitments.
stage live {
  %% [V02-C03-S2] Only affirmative assent adds a participant to the plan.
  include_confirmed_guest [story] : invited_guest(T,P) * accepted_invite(T,P) -o confirmed_guest(T,P).
}
pred active_plan(task,slot) : commitments.
stage live {
  %% [V02-C08-S3] Record the confirmed plan as intent.
  record_confirmed_plan [story] : observed_plan(T,S) -o active_plan(T,S).
}
pred plan_revision_kept(task,slot,slot) : commitments.
stage live {
  %% [V02-C08-S3] Change the matching current slot only after confirmation.
  acknowledge_revised_plan [story] : active_plan(T,A) * agreed_revision(T,A,B) * A <> B -o active_plan(T,B) * plan_revision_kept(T,A,B).
}

pred conditional_invitation(task,participant) : commitments.
pred followup_awaiting_receipt(task,participant) : commitments.
pred followup_recorded(task,participant) : commitments.
stage live {
  %% [V02-C03-S2] Keep a tentative guest eligible for a conditional invitation.
  offer_conditional_invitation [story] : $invited_guest(T,P) * tentative_reply(T,P) -o conditional_invitation(T,P).
  %% [V02-C08-S1] Keep explicitly delegated follow-up work separate from attendance.
  request_followup_record [story] : delegated_followup(T,P) -o followup_awaiting_receipt(T,P).
  %% [V02-C08-S1] Record the follow-up only on a matching simulated receipt.
  acknowledge_followup_record [story] : followup_awaiting_receipt(T,P) * followup_receipt(T,P) -o followup_recorded(T,P).
}
