catalog social_domain 1.
% Book I, fiction revision 94e2c582.
layers (story dyn).
stages (live).
namespace social produce (story).

pred resident_invited_to_explain : social.
stage live {
  %% [B01-C03-S03] "I'll let him explain it."
  defer_private_answer [story] : $privacy_boundary * visitor_asks_about_resident -o resident_invited_to_explain.
}
stage live {
  %% [B09-C02-end] A confidence may be answered only in its authorized channel.
  reply_in_confidence [story] : private_question(T,C) * $authorized_channel(T,C) * $private_session(C) -o scoped_answer(T,C).
}
stage live {
  %% [V02-C07-end] A group turn addressed to Nina can be answered in its own channel.
  take_addressed_turn [story] : group_turn(C) * nina_addressed(C) -o reply_due(C).
}
pred social_scope_kept(participant) : social.
stage live {
  %% [V02-C01-S1] Agreement to a community remit grants authority within that remit.
  honor_community_scope [story] : community_role(P) * $agreed_social_scope(P) -o social_scope_kept(P).
}
pred displayable_component(asset) : social.
stage live {
  %% [V02-C06-S4] Require permission from the contributor for that exact asset.
  authorize_component_display [story] : shared_component(A,P) * display_permission(A,P) -o displayable_component(A).
}
pred reply_destination(message,participant,channel) : social.
stage live {
  %% [V02-C07-S1] Bind an invited reply to the actual sender and session membership.
  reply_to_person_in_session [story] : addressed_message(M,P,C) * $channel_member(P,C) * response_invited(M) -o reply_destination(M,P,C).
}
pred credit_repair(task,participant,channel) : social.
stage live {
  %% [V02-C11-S4] Make the repair track the affected person’s approved credit.
  correct_attribution_with_subject [story] : attribution_challenged(T,P) * approved_credit(T,P) * $original_credit_audience(T,C) * approved_repair_audience(T,C) -o credit_repair(T,P,C).
}
