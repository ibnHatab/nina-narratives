% director — Nina's director (nina-live, 2026-11-24): the catalog's lifted base (../director_domain.llp, a
% byte-equal copy) and this home's instance. The scenes package is the planner: a scene's three wishes arrive as
% kinds, and each goes to the one package that handles it. The packages run every tick whatever the director says:
% its wake and sleep are its own bookkeeping (Nina serves all five cards).
catalog director 1.
provenance text "the home's director: a scene's wishes to the lights, the air and the media" "2026-11-24".
include "../director_domain.llp".

type domain {lights air media comfort scenes timers agenda music habits glow persona}.
type kind {scene_lights scene_air scene_media scene_timers scene_music mood_music mood_glow
  ask_lights ask_air ask_media ask_comfort ask_scenes ask_timers ask_agenda ask_music ask_habits ask_glow ask_persona}.

specialist(lights).
specialist(air).
specialist(media).
specialist(comfort).
specialist(timers).
specialist(agenda).
specialist(music).
specialist(habits).
specialist(glow).
specialist(persona).
planner(scenes).
% the person's intents, one kind per card (iface/home.llp): the director wakes and forwards them; its
% attention is then the card the person last spoke to.
handles(lights, ask_lights).
handles(air, ask_air).
handles(media, ask_media).
handles(comfort, ask_comfort).
handles(scenes, ask_scenes).
handles(timers, ask_timers).
handles(agenda, ask_agenda).
handles(music, ask_music).
handles(habits, ask_habits).
handles(glow, ask_glow).
handles(persona, ask_persona).
handles(lights, scene_lights).
handles(air, scene_air).
handles(media, scene_media).
handles(timers, scene_timers).
handles(music, scene_music).
handles(music, mood_music).
handles(glow, mood_glow).

#init active(scenes) 1
#init attention(scenes) 1
#init fresh 1
#init inactive(lights) 1
#init inactive(air) 1
#init inactive(media) 1
#init inactive(comfort) 1
#init inactive(timers) 1
#init inactive(agenda) 1
#init inactive(music) 1
#init inactive(habits) 1
#init inactive(glow) 1
#init inactive(persona) 1
