% generated by world/gen_map.py from world/home.map.json: do not edit
% The home's mode, read from the world as a level (home_mode), swept once per change: this package's sweep
% rules settle each device (the scenes say WHAT, the package knows HOW), its latch the mode it last swept for.
catalog lights_fan 1.
stage serve {
  %% The home scene: nothing to do here.
  fan_home [dyn] : $home_mode(yes, home) * swept(M) * other(M, home) -o swept(home).
  %% The night scene: every device of mine gets its wish.
  fan_night [dyn] : $home_mode(yes, night) * swept(M) * other(M, night) -o swept(night) * sweep_off(l1) * sweep_off(l2).
  %% The away scene: every device of mine gets its wish.
  fan_away [dyn] : $home_mode(yes, away) * swept(M) * other(M, away) -o swept(away) * sweep_off(l1) * sweep_off(l2).
}
% the latch's start (swept(home)) is the package's own #init: an included file's is not read
