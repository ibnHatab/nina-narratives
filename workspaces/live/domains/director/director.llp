% director — Nina's one director (the redesign's W4, notes/step3-cognition-live.md): the devices' cards and the
% cognition's members under one planner, attention. A person's goal to a card arrives as its ask_<pkg> kind (the
% runtime's intent route); the cognition's offers (reminder_offer, topic_offer) go to the planner; the receipt of an
% utterance (uttered) to the commitments. The scenes no longer route through a planner: they conclude the home's mode
% into the world, which every package reads as a level (W3).
catalog director 1.
provenance text "the one director: the person's goals to the cards, the cognition's offers to attention" "2026-11-28".
include "../director_domain.llp".
include "../capacity.llp".
type kind {ask_lights ask_air ask_media ask_comfort ask_scenes ask_timers ask_agenda ask_music ask_habits ask_glow ask_temperament ask_escalate reminder_offer uttered topic_offer}.
planner(attention).
specialist(lights).
specialist(air).
specialist(media).
specialist(comfort).
specialist(scenes).
specialist(timers).
specialist(agenda).
specialist(music).
specialist(habits).
specialist(glow).
specialist(temperament).
specialist(escalate).
specialist(situations).
specialist(commitments).
specialist(social).
specialist(curiosity).
specialist(self_model).
specialist(persona).
handles(lights, ask_lights).
handles(air, ask_air).
handles(media, ask_media).
handles(comfort, ask_comfort).
handles(scenes, ask_scenes).
handles(timers, ask_timers).
handles(agenda, ask_agenda).
handles(music, ask_music).
handles(habits, ask_habits).
handles(glow, ask_glow).
handles(temperament, ask_temperament).
handles(escalate, ask_escalate).
handles(attention, reminder_offer).
handles(commitments, uttered).
handles(attention, topic_offer).
#init fresh 1
#init attention(attention) 1
#init active(attention) 1
#init inactive(lights) 1
#init inactive(air) 1
#init inactive(media) 1
#init inactive(comfort) 1
#init inactive(scenes) 1
#init inactive(timers) 1
#init inactive(agenda) 1
#init inactive(music) 1
#init inactive(habits) 1
#init inactive(glow) 1
#init inactive(temperament) 1
#init inactive(escalate) 1
#init inactive(situations) 1
#init inactive(commitments) 1
#init inactive(social) 1
#init inactive(curiosity) 1
#init inactive(self_model) 1
#init inactive(persona) 1
% Live supplies a changed or steady status boundary per member (spec 15 §9.3).
% The director keeps the status age bounded, as in director_tree_domain.
type age {a0 a1 a2 a3}.
bwd older(age,age).
older(a0,a1).
older(a1,a2).
older(a2,a3).
pred changed(domain) : dir.
pred tick_s(domain) : dir.
pred age_of(domain,age) : dir.
stage act {
  %% The status of {D} changed on this boundary.
  status_reset [dyn] : changed(D) * age_of(D,A) -o age_of(D,a0).
  %% The status of {D} held for another boundary.
  status_age [dyn] : tick_s(D) * age_of(D,A) * $older(A,B) -o age_of(D,B).
}
#init age_of(lights,a0) 1
#init age_of(air,a0) 1
#init age_of(media,a0) 1
#init age_of(comfort,a0) 1
#init age_of(scenes,a0) 1
#init age_of(timers,a0) 1
#init age_of(agenda,a0) 1
#init age_of(music,a0) 1
#init age_of(habits,a0) 1
#init age_of(glow,a0) 1
#init age_of(temperament,a0) 1
#init age_of(escalate,a0) 1
#init age_of(situations,a0) 1
#init age_of(commitments,a0) 1
#init age_of(attention,a0) 1
#init age_of(social,a0) 1
#init age_of(curiosity,a0) 1
#init age_of(self_model,a0) 1
#init age_of(persona,a0) 1

